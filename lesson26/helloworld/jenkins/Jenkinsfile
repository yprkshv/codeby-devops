pipeline {
    agent {
        label 'maven'
    }
    options {
        skipStagesAfterUnstable()
    }
    tools {
        maven 'maven3'
    }
    stages {
        stage('Build') {
            steps {
                dir('lesson26/helloworld') {
                            sh 'mvn -B -DskipTests clean package'
                }
            }
        }
        stage('Test') {
            steps {
                dir('lesson26/helloworld') {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'mp_lesson26/lesson26/helloworld/target/surefire-reports/*.xml'
                }
            }
        }
        stage('Deliver') { 
            steps {
                dir('lesson26/helloworld') {
                sh './jenkins/scripts/deliver.sh' 
                    }
                }
            }
        }
    }
}
