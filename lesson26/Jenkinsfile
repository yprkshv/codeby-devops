pipeline {
    agent {
        label 'maven'
    }
    options {
        skipStagesAfterUnstable()
    }
    tools {
        maven 'maven3'
    }
    stages {
        stage('Applications') {
            parallel {

                stage('Hello World') {
                    stages {
                        stage('Build') {
                            steps {
                                dir('lesson26/helloworld') {
                                    sh 'mvn -B -DskipTests clean package'
                                }
                            }
                        }
                        stage('Test') {
                            steps {
                                dir('lesson26/helloworld') {
                                    sh 'mvn test'
                                }
                            }
                            post {
                                always {
                                    junit 'target/surefire-reports/*.xml'
                                }
                            }
                        }
                        stage('Deliver') {
                            steps {
                                dir('lesson26/helloworld') {
                                    sh 'chmod +x ./jenkins/scripts/deliver.sh'
                                    sh './jenkins/scripts/deliver.sh'
                                }
                            }
                        }
                    }
                }

                stage('Hello Jenkins') {
                    stages {
                        stage('Build') {
                            steps {
                                dir('lesson26/hellojenkins') {
                                    sh 'mvn -B -DskipTests clean package'
                                }
                            }
                        }
                        stage('Test') {
                            steps {
                                dir('lesson26/hellojenkins') {
                                    sh 'mvn test'
                                }
                            }
                            post {
                                always {
                                    junit 'target/surefire-reports/*.xml'
                                }
                            }
                        }
                        stage('Deliver') {
                            steps {
                                dir('lesson26/hellojenkins') {
                                    sh 'chmod +x ./jenkins/scripts/deliver.sh'
                                    sh './jenkins/scripts/deliver.sh'
                                }
                            }
                        }
                    }
                }

                stage('Hello Maven') {
                    stages {
                        stage('Build') {
                            steps {
                                dir('lesson26/hellodevops') {
                                    sh 'mvn -B -DskipTests clean package'
                                }
                            }
                        }
                        stage('Test') {
                            steps {
                                dir('lesson26/hellodevops') {
                                    sh 'mvn test'
                                }
                            }
                            post {
                                always {
                                    junit 'target/surefire-reports/*.xml'
                                }
                            }
                        }
                        stage('Deliver') {
                            steps {
                                dir('lesson26/hellodevops') {
                                    sh 'chmod +x ./jenkins/scripts/deliver.sh'
                                    sh './jenkins/scripts/deliver.sh'
                                }
                            }
                        }
                    }
                }

            }
        }
    }
}
